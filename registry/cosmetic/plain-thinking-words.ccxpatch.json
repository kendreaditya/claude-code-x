{
  "schema_version": 1,
  "id": "plain-thinking-words",
  "name": "Plain Thinking Words",
  "group": "cosmetic",
  "level": "binary",
  "description": "Replaces the whimsical spinner/loading verb pool (187 words like Flibbertigibbeting, Discombobulating, Clauding, Boondoggling) with a single plain word 'Thinking'. Rewrites the entire SPINNER_VERBS JS array literal in place, same-length, by space-padding inside one string literal so binary offsets are preserved. Mirrors github.com/ominiverdi/claude-depester.",
  "provenance": {
    "source_repo": "ominiverdi/claude-depester",
    "source_url": "https://github.com/ominiverdi/claude-depester",
    "author": "ominiverdi",
    "license": "unknown",
    "derived_by": "anchored against pristine 2.1.158 using 2.1.88 source ref (constants/spinnerVerbs.ts)"
  },
  "applies_to": {
    "containers": [
      "macho-arm64-bun",
      "macho-x64-bun",
      "elf-x64-bun"
    ],
    "version_range": ">=2.1.0 <3.0.0",
    "verified_on": [
      "2.1.158"
    ]
  },
  "allow_variable_length": false,
  "operations": [
    {
      "op_id": "spinner-verbs-array-to-thinking",
      "kind": "landmark-anchored",
      "rationale": "Replace the whimsical spinner-verb array with a single-element [\"Thinking\"] array, padding with whitespace before the closing bracket to keep byte length identical. The captured ident length cancels, so same-length holds regardless of minifier churn.",
      "must_be_unique": true,
      "same_length": true,
      "in_bun_region": true,
      "anchor": "(\\w+)=\\[\"Accomplishing\",(?:\"(?:[^\"\\\\]|\\\\.)*\",?)+\"Zigzagging\"\\]",
      "replace": "\\g<1>=[\"Thinking\"                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                      ]",
      "patched_anchor": "(\\w+)=\\[\"Thinking\" {2422}\\]"
    }
  ]
}
